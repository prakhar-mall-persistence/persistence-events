# ---- Database (Neon Postgres) ----
# Get from https://neon.tech -> your project -> Connection string (pooled)
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- Anthropic (LLM ICP scoring) ----
ANTHROPIC_API_KEY="sk-ant-..."

# ---- Kit / ConvertKit (Broadcast API v4) ----
# https://app.kit.com/account_settings/developer_settings
KIT_API_KEY="kit_..."
# Numeric tag/segment id that the daily newsletter is sent to
KIT_SUBSCRIBER_TAG_ID=""
# Optional: only send to a single test address while validating
KIT_TEST_EMAIL=""

# ---- Eventbrite (official API) ----
EVENTBRITE_TOKEN=""

# ---- Public URL of the deployed dashboard (used for the newsletter CTA) ----
DASHBOARD_URL="https://persistence-events.vercel.app"

# ---- Shared secret protecting /api/scrape/trigger ----
CRON_TRIGGER_SECRET="change-me-to-a-long-random-string"

# ---- One-click "Scrape now" button (dashboard) — dispatches the GitHub Actions workflow ----
# owner/repo, e.g. "prakhar-mall-persistence/persistence-events"
GITHUB_REPO=""
# A GitHub token with actions:write (classic PAT with 'workflow' scope, or fine-grained w/ Actions:write)
GITHUB_DISPATCH_TOKEN=""
